  tone(BUZZER, NOTE_D4, 250); delay(325); noTone(BUZZER);
  tone(BUZZER, NOTE_D4, 250); delay(325); noTone(BUZZER);
  tone(BUZZER, NOTE_C4, 500); delay(650); noTone(BUZZER);

