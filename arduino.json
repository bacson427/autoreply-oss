### BT2: Bộ đếm lên/xuống 8 bit (Spam trực tiếp trong `loop`, không tách hàm con)

```cpp
#include <LiquidCrystal.h>

// Đã bỏ số 255 gây lỗi
LiquidCrystal lcd(12, 11, 0, 1, 2, 3, 4, 5, 6, 7);

#define S1 8
#define S2 9

int count = 129;   // ĐỔI THÀNH 3 SỐ CUỐI MSSV (Nếu > 255 thì lấy số dư cho 256)

void setup() {
  pinMode(S1, INPUT);
  pinMode(S2, INPUT);

  lcd.begin(16, 2);

  lcd.setCursor(0, 0);
  lcd.print("S1:UP  S2:down");

  // Hiển thị lần đầu khi mới cấp điện
  lcd.setCursor(0, 1);
  lcd.print("                ");
  lcd.setCursor(0, 1);
  lcd.print(count);

  lcd.setCursor(5, 1);
  lcd.print(bitRead(count, 7));
  lcd.print(bitRead(count, 6));
  lcd.print(bitRead(count, 5));
  lcd.print(bitRead(count, 4));
  lcd.print(bitRead(count, 3));
  lcd.print(bitRead(count, 2));
  lcd.print(bitRead(count, 1));
  lcd.print(bitRead(count, 0));
}

void loop() {
  // Nếu nhấn S1 (Tăng)
  if (digitalRead(S1) == HIGH) {
    if (count < 255) {
      count = count + 1;
    }

    lcd.setCursor(0, 1);
    lcd.print("                ");
    lcd.setCursor(0, 1);
    lcd.print(count);

    lcd.setCursor(5, 1);
    lcd.print(bitRead(count, 7));
    lcd.print(bitRead(count, 6));
    lcd.print(bitRead(count, 5));
    lcd.print(bitRead(count, 4));
    lcd.print(bitRead(count, 3));
    lcd.print(bitRead(count, 2));
    lcd.print(bitRead(count, 1));
    lcd.print(bitRead(count, 0));

    while (digitalRead(S1) == HIGH);   // Chờ nhả nút
    delay(50);
  }

  // Nếu nhấn S2 (Giảm)
  if (digitalRead(S2) == HIGH) {
    if (count > 0) {
      count = count - 1;
    }

    lcd.setCursor(0, 1);
    lcd.print("                ");
    lcd.setCursor(0, 1);
    lcd.print(count);

    lcd.setCursor(5, 1);
    lcd.print(bitRead(count, 7));
    lcd.print(bitRead(count, 6));
    lcd.print(bitRead(count, 5));
    lcd.print(bitRead(count, 4));
    lcd.print(bitRead(count, 3));
    lcd.print(bitRead(count, 2));
    lcd.print(bitRead(count, 1));
    lcd.print(bitRead(count, 0));

    while (digitalRead(S2) == HIGH);   // Chờ nhả nút
    delay(50);
  }
}

```

