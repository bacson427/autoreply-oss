## 👉 BÀI 5: CẢM BIẾN NHIỆT ĐỘ LM35 + LCD (Đã fix lỗi số 255)

```cpp
#include <LiquidCrystal.h>

// Đã bỏ số 255 gây lỗi
LiquidCrystal lcd(12, 11, 0, 1, 2, 3, 4, 5, 6, 7);

int sensorPin = A0;

void setup() {
  lcd.begin(16, 2);

  lcd.setCursor(0, 0);
  lcd.print("NHIET DO LM35");
}

void loop() {
  int adc = analogRead(sensorPin);

  float volt = adc * 5.0 / 1023.0;
  float tempC = volt * 100.0;      // LM35: 10mV tương ứng 1 độ C

  lcd.setCursor(0, 1);
  lcd.print("T = ");
  lcd.print(tempC, 1);             // Lấy 1 chữ số sau dấu phẩy
  lcd.print(" C    ");

  delay(500);
}

```
