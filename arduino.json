👉BT2: Bộ đếm lên/xuống 8 bit (Bắt đầu từ 3 số cuối MSSV)

#include <LiquidCrystal.h>

LiquidCrystal lcd(12, 255, 11, 0, 1, 2, 3, 4, 5, 6, 7);

#define S1 8
#define S2 9

int count = 129;   // ĐỔI THÀNH 3 SỐ CUỐI MSSV CỦA BẠN

void hienThi() {
  lcd.setCursor(0, 1);
  lcd.print("                ");   // Xóa dòng 2

  lcd.setCursor(0, 1);
  lcd.print(count);                // In số thập phân

  lcd.setCursor(5, 1);
  lcd.print(bitRead(count, 7));
  lcd.print(bitRead(count, 6));
  lcd.print(bitRead(count, 5));
  lcd.print(bitRead(count, 4));
  lcd.print(bitRead(count, 3));
  lcd.print(bitRead(count, 2));
  lcd.print(bitRead(count, 1));
  lcd.print(bitRead(count, 0));
}

void setup() {
  pinMode(S1, INPUT);
  pinMode(S2, INPUT);

  lcd.begin(16, 2);

  lcd.setCursor(0, 0);
  lcd.print("S1:UP  S2:down");

  hienThi();
}

void loop() {
  if (digitalRead(S1) == HIGH) {
    if (count < 255) {
      count = count + 1;
    }
    hienThi();
    while (digitalRead(S1) == HIGH);   // Chờ nhả nút
    delay(50);
  }

  if (digitalRead(S2) == HIGH) {
    if (count > 0) {
      count = count - 1;
    }
    hienThi();
    while (digitalRead(S2) == HIGH);   // Chờ nhả nút
    delay(50);
  }
}

👉BÀI 5: CẢM BIẾN NHIỆT ĐỘ LM35 + LCD
(LM35: Chân 1 → 5V, Chân 2 → A0, Chân 3 → GND. LCD nối giống Bài 4)

#include <LiquidCrystal.h>

LiquidCrystal lcd(12, 255, 11, 0, 1, 2, 3, 4, 5, 6, 7);

int sensorPin = A0;

void setup() {
  lcd.begin(16, 2);

  lcd.setCursor(0, 0);
  lcd.print("NHIET DO LM35");
}

void loop() {
  int adc = analogRead(sensorPin);

  float volt = adc * 5.0 / 1023.0;
  float tempC = volt * 100.0;      // LM35: 10mV/°C

  lcd.setCursor(0, 1);
  lcd.print("T = ");
  lcd.print(tempC, 1);             // In 1 chữ số thập phân
  lcd.print(" C    ");

  delay(500);
}
