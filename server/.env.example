# Required - generate a random string
BOT_SECRET=change_me_to_random_string

# Required - get from https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required - get from https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - Cloudflare Workers AI (3rd fallback)
# Get from https://dash.cloudflare.com -> Workers & Pages
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CF_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - change AI models
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash
CF_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Required for auto-update feature - set to YOUR GitHub username/repo
GITHUB_REPO=your-username/autoreply-oss
